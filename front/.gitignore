# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
echo "server/job-notification/.notification-state.json" >> .gitignore
echo "server/job-notification/.notification-state.json.bak" >> .gitignore
git rm --cached server/job-notification/.notification-state.json
git rm --cached server/job-notification/.notification-state.json.bak
git add .gitignore
git commit -m "ignore notification state files"
git push --force-with-lease